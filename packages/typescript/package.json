{
  "name": "@yeetgodpro1324/jokelboard-ts",
  "version": "1.1.1",
  "description": "TypeScript client for the Jokelboard API",
  "keywords": [
    "jokelboard",
    "api",
    "typescript",
    "kanban"
  ],
  "license": "MIT",
  "author": "code-dev1324",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-dev1324/jokelboard-wrapper.git",
    "directory": "packages/typescript"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
